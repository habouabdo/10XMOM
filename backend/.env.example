# Copy to .env. Never commit .env. The frontend never sees these values.
NODE_ENV=development
PORT=4000

# MySQL 8.4 on the company server (or localhost for development)
DATABASE_URL="mysql://10xmom:CHANGE_ME@localhost:3306/10xmom"

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Origin(s) allowed to call the API directly (comma separated). The Next.js proxy does not need CORS.
CORS_ORIGINS=http://localhost:3000

# Used only by `npm run seed` to create the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS

# Set to 1 when served over HTTPS (secure cookies) / behind a reverse proxy
COOKIE_SECURE=0
TRUST_PROXY=0
